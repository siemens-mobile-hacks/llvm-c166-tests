#!/usr/bin/env python3
"""Validate C166 test manifests against the repository schema."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

import fastjsonschema


def main() -> int:
    parser = argparse.ArgumentParser(usage="tools/validate-manifest MANIFEST ...")
    parser.add_argument("manifests", nargs="+", type=Path)
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[1]
    schema = json.loads((root / "schema/case.schema.json").read_text())
    validate = fastjsonschema.compile(schema)

    failed = False
    for path in args.manifests:
        try:
            validate(json.loads(path.read_text()))
        except (OSError, json.JSONDecodeError,
                fastjsonschema.JsonSchemaException) as error:
            print(f"validate-manifest: {path}: {error}", file=sys.stderr)
            failed = True
    return int(failed)


if __name__ == "__main__":
    raise SystemExit(main())
