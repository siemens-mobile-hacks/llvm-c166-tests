#!/usr/bin/env bash
set -euo pipefail

if (($# == 0)); then
  echo "usage: with-isolated-output COMMAND [ARG ...]" >&2
  exit 2
fi

tmp_root="${TMPDIR:-/tmp}/llvm-c166-tests"
mkdir -p "$tmp_root"
capture_dir="$(mktemp -d "${tmp_root}/c166-test-output.XXXXXXXX")"
stdout_file="${capture_dir}/stdout"
stderr_file="${capture_dir}/stderr"

cleanup() {
  rm -rf -- "$capture_dir"
}
trap cleanup EXIT

status=0
"$@" >"$stdout_file" 2>"$stderr_file" || status=$?

cat "$stdout_file"
cat "$stderr_file" >&2
exit "$status"
