#!/usr/bin/env python3
"""Materialize one seeded binary32 ISS case from the canonical template."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
import subprocess


COPIED_FILES = ("abi-boundary.asm", "host.c", "llvm.c", "types.h")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--template", required=True, type=Path)
    parser.add_argument("--optimization", default="O2")
    parser.add_argument("--iterations", type=int, required=True)
    parser.add_argument("--checkpoint-interval", type=int, required=True)
    parser.add_argument("--seed", action="append", required=True,
                        type=lambda value: int(value, 0))
    parser.add_argument("--suite-id", type=int, default=312)
    parser.add_argument("--simulator-timeout", type=int, default=600)
    parser.add_argument("--timeout", type=int, default=720)
    args = parser.parse_args()
    if args.optimization not in ("O0", "O1", "O2", "O3", "Os", "Oz"):
        parser.error("unsupported optimization")
    if args.output.exists() and any(args.output.iterdir()):
        parser.error("--output must not contain existing files")
    return args


def run_generator(generator: Path, mode: str, args: argparse.Namespace) -> str:
    command = [
        str(generator), mode,
        "--iterations", str(args.iterations),
        "--checkpoint-interval", str(args.checkpoint_interval),
        "--suite-id", str(args.suite_id),
    ]
    for seed in args.seed:
        command.extend(("--seed", hex(seed)))
    return subprocess.run(
        command, check=True, stdout=subprocess.PIPE, text=True
    ).stdout


def main() -> int:
    args = parse_args()
    args.output.mkdir(parents=True, exist_ok=True)
    for name in COPIED_FILES:
        shutil.copyfile(args.template / name, args.output / name)

    generator = Path(__file__).resolve().with_name("gen-seeded-f32-corpus")
    (args.output / "corpus.inc").write_text(
        run_generator(generator, "corpus", args), encoding="utf-8")
    signature = int(run_generator(
        generator, "manifest-signature", args).strip())
    result_count = int(run_generator(generator, "result-count", args).strip())
    checkpoint_count = int(run_generator(
        generator, "check-count", args).strip())

    manifest = json.loads(
        (args.template / "case.json").read_text(encoding="utf-8"))
    manifest["optimizations"] = [args.optimization]
    labels = set(manifest["labels"] + ["runner-seed", "stress"])
    if result_count >= 100000:
        labels.add("stress-100k")
    manifest["labels"] = sorted(labels)
    manifest["result"]["suite_id"] = args.suite_id
    manifest["result"]["expected_signature"] = signature
    manifest["simulator_timeout"] = args.simulator_timeout
    manifest["timeout"] = args.timeout
    manifest["generation"] = {
        "checkpoint_interval": args.checkpoint_interval,
        "checkpoints": checkpoint_count,
        "iterations": args.iterations,
        "results_per_optimization": result_count,
        "seeds": args.seed,
    }
    (args.output / "case.json").write_text(
        json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
