#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: tools/run-seeded-stress KIND [OPTIMIZATION]" >&2
}

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
kind=${1:-}
optimization=${2:-O2}
temp_root=/tmp/llvm-c166-tests

case "${kind}" in
  abi-call)
    iterations=40
    checkpoint_interval=8
    seed_list=0x1660ca11,0xc166ab1c,0x5eedca11,0xdeadca11
    results_per_iteration=66
    minimum=10000
    unit=calls
    template=seeded-abi-call
    ;;
  f32)
    iterations=6400
    checkpoint_interval=64
    seed_list=0x1660f32a,0xc166f32b,0x5eedf32c,0x0123f32d
    results_per_iteration=4
    minimum=100000
    unit=results
    template=seeded-f32-differential
    ;;
  f64)
    iterations=6400
    checkpoint_interval=64
    seed_list=0x1660f64a1b2c3d4e,0xc166d0b15eed1234,0x5eedf64a89abcdef,0x0123456789abcdef
    results_per_iteration=4
    minimum=100000
    unit=results
    template=seeded-f64-differential
    ;;
  far-pointer)
    iterations=256
    checkpoint_interval=8
    seed_list=0x1660fa41,0xc1665eed,0x0123f00d,0xdeadf00d
    results_per_iteration=16
    minimum=10000
    unit=results
    template=seeded-far-pointer
    ;;
  integer)
    iterations=640
    checkpoint_interval=
    seed_list=0x00000001,0x1660c166,0xdeadbeef
    results_per_iteration=54
    minimum=100000
    unit=checks
    template=seeded-integer-differential
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage
    exit 2
    ;;
esac

[[ ${optimization} =~ ^O(0|1|2|3|s|z)$ ]] || {
  echo "invalid optimization: ${optimization}" >&2
  exit 2
}
IFS=, read -r -a seeds <<<"${seed_list}"

result_count=$((${#seeds[@]} * iterations * results_per_iteration))
if ((result_count < minimum)); then
  echo "stress configuration has only ${result_count} ${unit}; require at least ${minimum}" >&2
  exit 2
fi
stress_name="${template}-$((minimum / 1000))k"

mkdir -p "${temp_root}"
case_dir=$(mktemp -d "${temp_root}/c166-seeded-${kind}-stress.XXXXXXXX")
trap 'rm -rf -- "${case_dir}"' EXIT
prepare=(
  "${project_root}/tools/prepare-seeded-case" "${kind}"
  --output "${case_dir}"
  --template "${project_root}/tests/stress/${template}"
  --optimization "${optimization}"
  --iterations "${iterations}"
)
if [[ -n ${checkpoint_interval} ]]; then
  prepare+=(--checkpoint-interval "${checkpoint_interval}")
fi
for seed in "${seeds[@]}"; do
  prepare+=(--seed "${seed}")
done
"${prepare[@]}" >/dev/null

echo "C166 seeded ${kind} stress: ${result_count} ${unit}, ${#seeds[@]} seeds, ${iterations} iterations"
"${project_root}/harness/run-sim" \
  "${case_dir}" "$stress_name" "${optimization}"
