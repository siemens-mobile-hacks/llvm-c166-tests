#!/usr/bin/env bash
set -euo pipefail

project_root=${C166_TEST_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}
optimization=${1:-O2}
iterations=${C166_F32_STRESS_ITERATIONS:-6400}
checkpoint_interval=${C166_F32_STRESS_CHECKPOINT_INTERVAL:-64}
seed_list=${C166_F32_STRESS_SEEDS:-0x1660f32a,0xc166f32b,0x5eedf32c,0x0123f32d}
temp_root=${C166_TEST_TMP_ROOT:-/tmp/codex}

[[ ${optimization} =~ ^O(0|1|2|3|s|z)$ ]] || {
  echo "invalid optimization: ${optimization}" >&2
  exit 2
}
[[ ${iterations} =~ ^[1-9][0-9]*$ ]] || {
  echo "invalid C166_F32_STRESS_ITERATIONS: ${iterations}" >&2
  exit 2
}
[[ ${checkpoint_interval} =~ ^[1-9][0-9]*$ ]] || {
  echo "invalid C166_F32_STRESS_CHECKPOINT_INTERVAL: ${checkpoint_interval}" >&2
  exit 2
}
IFS=, read -r -a seeds <<<"${seed_list}"
((${#seeds[@]} > 0)) || {
  echo "C166_F32_STRESS_SEEDS is empty" >&2
  exit 2
}

results=$((${#seeds[@]} * iterations * 4))
if ((results < 100000)); then
  echo "stress configuration has only ${results} results; require at least 100000" >&2
  exit 2
fi

mkdir -p "${temp_root}"
case_dir=$(mktemp -d "${temp_root}/c166-seeded-f32-stress.XXXXXXXX")
trap 'rm -rf -- "${case_dir}"' EXIT
prepare=(
  "${project_root}/tools/prepare-seeded-f32-case"
  --output "${case_dir}"
  --template "${project_root}/tests/stress/seeded-f32-differential"
  --optimization "${optimization}"
  --iterations "${iterations}"
  --checkpoint-interval "${checkpoint_interval}"
)
for seed in "${seeds[@]}"; do
  prepare+=(--seed "${seed}")
done
"${prepare[@]}" >/dev/null

echo "C166 seeded f32 stress: ${results} results, ${#seeds[@]} seeds, ${iterations} iterations"
C166_TEST_ROOT="${project_root}" "${project_root}/harness/run-sim" \
  "${case_dir}" seeded-f32-stress "${optimization}"
