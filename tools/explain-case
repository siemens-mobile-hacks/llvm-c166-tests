#!/usr/bin/env python3
"""Explain a case's manifest-derived execution matrix."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


parser = argparse.ArgumentParser()
parser.add_argument("case")
parser.add_argument(
    "--project-root", type=Path, default=Path(__file__).resolve().parents[1]
)
args = parser.parse_args()

matches = list(args.project_root.glob(f"tests/*/{args.case}/case.json"))
if len(matches) != 1:
    print(f"explain-case: expected one case named {args.case}, found {len(matches)}", file=sys.stderr)
    raise SystemExit(1)

manifest = json.loads(matches[0].read_text())
enabled = manifest.get("models", ["large"])
disabled = [model for model in ("large", "medium", "small") if model not in enabled]
print(f"case: {args.case}")
print(f"category: {manifest['category']}")
print(f"models: {', '.join(enabled)}")
print(f"optimizations: {', '.join(manifest['optimizations'])}")
print(f"runtime oracle: {manifest.get('tasking_runtime', 'system')}")
print(f"result protocol: {manifest['result']['protocol']}")
if disabled:
    print("not enabled:")
    for model in disabled:
        print(f"  {model}: no validated {model} evidence is declared by this case")
