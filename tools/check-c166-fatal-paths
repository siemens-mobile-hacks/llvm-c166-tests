#!/usr/bin/env python3
"""Validate the reviewed inventory of C166 backend termination paths."""

from __future__ import annotations

import argparse
import collections
import json
import re
import sys
from pathlib import Path


CALL_RE = re.compile(r"\b(assert|llvm_unreachable|report_fatal_error)\s*\(")
ALLOWED_CLASSIFICATIONS = {
    "internal_invariant",
    "supported_bug",
    "unsupported_feature",
}
ALLOWED_EXPOSURES = {"internal_ir", "public_c", "assembly_input"}
ALLOWED_STATUSES = {"proven_invariant", "covered", "open"}


def default_project() -> Path:
    return Path(__file__).resolve().parents[1].parent / "llvm-project"


def skip_quoted(source: str, pos: int, quote: str) -> int:
    pos += 1
    while pos < len(source):
        if source[pos] == "\\":
            pos += 2
        elif source[pos] == quote:
            return pos + 1
        else:
            pos += 1
    raise ValueError("unterminated quoted string")


def call_end(source: str, open_paren: int) -> int:
    depth = 1
    pos = open_paren + 1
    while pos < len(source):
        if source.startswith("//", pos):
            newline = source.find("\n", pos + 2)
            pos = len(source) if newline < 0 else newline + 1
        elif source.startswith("/*", pos):
            close = source.find("*/", pos + 2)
            if close < 0:
                raise ValueError("unterminated block comment")
            pos = close + 2
        elif source[pos] in {'"', "'"}:
            pos = skip_quoted(source, pos, source[pos])
        elif source[pos] == "(":
            depth += 1
            pos += 1
        elif source[pos] == ")":
            depth -= 1
            pos += 1
            if depth == 0:
                return pos
        else:
            pos += 1
    raise ValueError("unterminated fatal-path call")


def normalize(expression: str) -> str:
    return " ".join(expression.split())


def discover(project: Path) -> tuple[collections.Counter, dict[tuple, list[int]]]:
    root = project / "llvm/lib/Target/C166"
    if not root.is_dir():
        raise ValueError(f"missing C166 backend: {root}")
    found: collections.Counter = collections.Counter()
    lines: dict[tuple, list[int]] = collections.defaultdict(list)
    for path in sorted(root.rglob("*")):
        if path.suffix not in {".cpp", ".h"}:
            continue
        source = path.read_text(encoding="utf-8")
        for match in CALL_RE.finditer(source):
            open_paren = source.find("(", match.start())
            end = call_end(source, open_paren)
            expression = normalize(source[open_paren + 1 : end - 1])
            relative = path.relative_to(project).as_posix()
            key = (relative, match.group(1), expression)
            found[key] += 1
            lines[key].append(source.count("\n", 0, match.start()) + 1)
    return found, lines


def inventory_key(entry: dict) -> tuple[str, str, str]:
    return entry.get("path"), entry.get("kind"), entry.get("expression")


def dump_discovered(found: collections.Counter, lines: dict[tuple, list[int]]) -> None:
    entries = []
    for key in sorted(found):
        path, kind, expression = key
        entries.append(
            {
                "path": path,
                "kind": kind,
                "expression": expression,
                "occurrences": found[key],
                "lines": lines[key],
            }
        )
    json.dump(entries, sys.stdout, indent=2)
    print()


def validate_schema(data: object) -> list[str]:
    errors: list[str] = []
    if not isinstance(data, dict):
        return ["inventory root must be an object"]
    if data.get("schema_version") != 1:
        errors.append("schema_version must be 1")
    entries = data.get("paths")
    if not isinstance(entries, list):
        return errors + ["paths must be an array"]
    seen = set()
    for index, entry in enumerate(entries):
        label = f"paths[{index}]"
        if not isinstance(entry, dict):
            errors.append(f"{label} must be an object")
            continue
        key = inventory_key(entry)
        if not all(isinstance(value, str) and value for value in key):
            errors.append(f"{label} needs non-empty path/kind/expression")
        elif key in seen:
            errors.append(f"{label} duplicates {key}")
        else:
            seen.add(key)
        if not isinstance(entry.get("occurrences"), int) or entry["occurrences"] < 1:
            errors.append(f"{label}.occurrences must be a positive integer")
        if entry.get("classification") not in ALLOWED_CLASSIFICATIONS:
            errors.append(f"{label}.classification is invalid")
        if entry.get("exposure") not in ALLOWED_EXPOSURES:
            errors.append(f"{label}.exposure is invalid")
        if entry.get("status") not in ALLOWED_STATUSES:
            errors.append(f"{label}.status is invalid")
        if not isinstance(entry.get("rationale"), str) or not entry["rationale"].strip():
            errors.append(f"{label}.rationale must be non-empty")
        evidence = entry.get("evidence")
        if not isinstance(evidence, list) or not all(
            isinstance(item, str) and item for item in evidence
        ):
            errors.append(f"{label}.evidence must be a string array")
        if entry.get("status") == "proven_invariant" and not evidence:
            errors.append(f"{label}: proven_invariant requires evidence")
        if entry.get("classification") == "supported_bug" and entry.get("status") == "proven_invariant":
            errors.append(f"{label}: supported_bug cannot be a proven invariant")
    return errors


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--llvm-project", type=Path, default=default_project())
    parser.add_argument(
        "--inventory",
        type=Path,
        default=Path(__file__).resolve().parents[1] / "audit/fatal-paths.json",
    )
    parser.add_argument("--dump-discovered", action="store_true")
    parser.add_argument("--require-closed", action="store_true")
    args = parser.parse_args()

    try:
        found, lines = discover(args.llvm_project.resolve())
    except (OSError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    if args.dump_discovered:
        dump_discovered(found, lines)
        return 0

    try:
        data = json.loads(args.inventory.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        print(f"error: cannot read {args.inventory}: {error}", file=sys.stderr)
        return 2
    errors = validate_schema(data)
    entries = data.get("paths", []) if isinstance(data, dict) else []
    reviewed = collections.Counter()
    for entry in entries:
        if isinstance(entry, dict):
            key = inventory_key(entry)
            if all(isinstance(value, str) for value in key):
                reviewed[key] += entry.get("occurrences", 0)

    missing = found - reviewed
    stale = reviewed - found
    for key, count in sorted(missing.items()):
        errors.append(
            f"unreviewed source path ({count} occurrence): {key}; lines={lines[key]}"
        )
    for key, count in sorted(stale.items()):
        errors.append(f"stale inventory path ({count} occurrence): {key}")

    if errors:
        for error in errors:
            print(f"error: {error}", file=sys.stderr)
        return 1

    status_counts = collections.Counter(entry["status"] for entry in entries)
    class_counts = collections.Counter(entry["classification"] for entry in entries)
    primitive_count = sum(found.values())
    print(
        f"C166 fatal-path inventory: {primitive_count} source sites, "
        f"{len(entries)} reviewed records"
    )
    print(
        "classifications: "
        + ", ".join(f"{key}={class_counts[key]}" for key in sorted(class_counts))
    )
    print(
        "status: "
        + ", ".join(f"{key}={status_counts[key]}" for key in sorted(status_counts))
    )
    if args.require_closed and status_counts["open"]:
        print(
            f"error: {status_counts['open']} reviewed records remain open",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
