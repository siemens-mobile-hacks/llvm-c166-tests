#!/usr/bin/env bash
set -euo pipefail

if (($# == 0)); then
  echo "usage: with-noninteractive-wine COMMAND [ARG ...]" >&2
  exit 2
fi

# Keep Wine quiet without changing the display selected by ./run.
exec env \
  C166_NONINTERACTIVE_WINE_ACTIVE=1 \
  WINEDEBUG="${WINEDEBUG:--all}" \
  WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-winemenubuilder.exe=d}" \
  LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}" \
  "$@"
