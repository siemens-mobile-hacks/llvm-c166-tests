#!/usr/bin/env python3
"""Materialize a seeded simulator case from a checked-in template."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
import subprocess


SPECS = {
    "abi-call": {
        "generator": "gen-seeded-abi-call-corpus",
        "files": ("functions.h", "host.c", "llvm.c", "reference.c"),
        "suite_id": 316,
        "simulator_timeout": 600,
        "timeout": 720,
        "minimum": 10_000,
        "labels": ("runner-seed", "stress"),
        "generation": {"routes": 3, "signature_classes": 22},
    },
    "f32": {
        "generator": "gen-seeded-f32-corpus",
        "files": ("abi-boundary.asm", "host.c", "llvm.c", "types.h"),
        "suite_id": 312,
        "simulator_timeout": 600,
        "timeout": 720,
        "minimum": 100_000,
        "labels": ("runner-seed", "stress"),
    },
    "f64": {
        "generator": "gen-seeded-f64-corpus",
        "files": ("abi-boundary.asm", "host.c", "llvm.c", "types.h"),
        "suite_id": 308,
        "simulator_timeout": 900,
        "timeout": 1020,
        "minimum": 100_000,
        "labels": ("generated", "runner-seed", "stress"),
    },
    "far-pointer": {
        "generator": "gen-seeded-far-pointer-corpus",
        "files": ("host.c", "llvm.c", "types.h"),
        "suite_id": 314,
        "simulator_timeout": 600,
        "timeout": 720,
        "minimum": 10_000,
        "labels": ("runner-seed", "stress"),
    },
    "integer": {
        "generator": "gen-seeded-integer-corpus",
        "files": (
            "expected.dis", "expected.nm", "expressions.inc", "host.c",
            "llvm.c", "operations.h", "reference.c", "types.h",
        ),
        "suite_id": 307,
        "simulator_timeout": 600,
        "timeout": 720,
        "minimum": 100_000,
        "labels": ("generated", "runner-seed", "stress-100k"),
    },
}

OPTIMIZATIONS = ("O0", "O1", "O2", "O3", "Os", "Oz")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("kind", choices=SPECS)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--template", required=True, type=Path)
    parser.add_argument("--optimization", default="O2", choices=OPTIMIZATIONS)
    parser.add_argument("--iterations", type=int, required=True)
    parser.add_argument("--checkpoint-interval", type=int)
    parser.add_argument(
        "--seed", action="append", required=True, type=lambda value: int(value, 0)
    )
    parser.add_argument("--suite-id", type=int)
    parser.add_argument("--simulator-timeout", type=int)
    parser.add_argument("--timeout", type=int)
    args = parser.parse_args()

    if args.iterations < 1:
        parser.error("--iterations must be positive")
    if args.kind == "integer":
        if args.checkpoint_interval is not None:
            parser.error("integer cases do not use checkpoints")
    elif args.checkpoint_interval is None or args.checkpoint_interval < 1:
        parser.error("--checkpoint-interval must be positive")
    if args.output.exists() and any(args.output.iterdir()):
        parser.error("--output must not contain existing files")
    return args


def generator_output(generator: Path, mode: str, args: argparse.Namespace) -> str:
    command = [
        str(generator), mode, "--iterations", str(args.iterations),
        "--suite-id", str(args.suite_id),
    ]
    if args.checkpoint_interval is not None:
        command.extend(("--checkpoint-interval", str(args.checkpoint_interval)))
    for seed in args.seed:
        command.extend(("--seed", hex(seed)))
    return subprocess.run(
        command, check=True, stdout=subprocess.PIPE, text=True
    ).stdout


def main() -> int:
    args = parse_args()
    spec = SPECS[args.kind]
    args.suite_id = args.suite_id or spec["suite_id"]
    args.simulator_timeout = args.simulator_timeout or spec["simulator_timeout"]
    args.timeout = args.timeout or spec["timeout"]

    args.output.mkdir(parents=True, exist_ok=True)
    for name in spec["files"]:
        shutil.copyfile(args.template / name, args.output / name)

    generator = Path(__file__).resolve().with_name(spec["generator"])
    (args.output / "corpus.inc").write_text(
        generator_output(generator, "corpus", args), encoding="utf-8"
    )
    signature = int(generator_output(generator, "manifest-signature", args).strip())

    manifest = json.loads((args.template / "case.json").read_text(encoding="utf-8"))
    manifest["optimizations"] = [args.optimization]
    labels = set(manifest["labels"] + list(spec["labels"]))
    manifest["result"]["suite_id"] = args.suite_id
    manifest["result"]["expected_signature"] = signature
    manifest["simulator_timeout"] = args.simulator_timeout
    manifest["timeout"] = args.timeout

    if args.kind == "integer":
        result_count = len(args.seed) * args.iterations * 54
        generation = {
            "iterations": args.iterations,
            "seeds": args.seed,
            "checks_per_optimization": result_count,
        }
    else:
        result_count = int(generator_output(generator, "result-count", args).strip())
        checkpoint_count = int(
            generator_output(generator, "check-count", args).strip()
        )
        generation = {
            "checkpoint_interval": args.checkpoint_interval,
            "checkpoints": checkpoint_count,
            "iterations": args.iterations,
            "results_per_optimization": result_count,
            "seeds": args.seed,
            **spec.get("generation", {}),
        }
    if result_count >= spec["minimum"]:
        labels.add(f"stress-{spec['minimum'] // 1000}k")
    manifest["labels"] = sorted(labels)
    manifest["generation"] = generation
    (args.output / "case.json").write_text(
        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
    )
    print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
