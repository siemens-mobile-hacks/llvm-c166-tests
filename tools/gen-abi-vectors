#!/usr/bin/env python3
import sys

MASK32 = 0xFFFFFFFF


def signed_char(value: int) -> int:
    value &= 0xFF
    return value - 0x100 if value & 0x80 else value


def scalar_mix(head, pair, tail, stack0, stack1, stack2):
    value = pair & MASK32
    value = (value + ((head & 0xFFFF) << 16)) & MASK32
    value = (value + signed_char(tail)) & MASK32
    value ^= ((stack0 & 0xFFFF) << 1) & MASK32
    value = (value + (stack1 & MASK32)) & MASK32
    value ^= ((stack2 & 0xFFFF) << 16) | (stack0 & 0xFFFF)
    return value & MASK32


def stop_mix(a, b, c, pair, tail):
    value = pair & MASK32
    value = (value + ((a & 0xFFFF) << 16)) & MASK32
    value = (value + ((b & 0xFFFF) << 1) + (c & 0xFFFF)) & MASK32
    value ^= ((tail & 0xFFFF) << 16) | (b & 0xFFFF)
    return value & MASK32


