def far_memory_fill(seed):
    return [
        (seed + index * 0x25 + 0x5B) & 0xFF
        for index in range(48)
    ]


def far_memory_apply(seed, arena):
    arena = list(arena)
    dynamic = 1 + ((seed >> 4) & 0x0F)
    word0 = seed ^ 0xA55A
    long0 = 0x13579BDF ^ ((seed & 0xFFFF) << 8)
    tail_long = (0x89ABCDEF + seed) & MASK32

    arena[4] = seed & 0xFF
    arena[5] = (seed >> 8) & 0xFF
    arena[6] = word0 & 0xFF
    arena[7] = word0 >> 8
    for index, value in enumerate((long0, tail_long)):
        offset = 12 if index == 0 else 44
        for byte in range(4):
            arena[offset + byte] = (value >> (byte * 8)) & 0xFF
    arena[16] ^= (seed & 0xFF) ^ 0x3C
    arena[16 + dynamic] ^= ((seed >> 8) & 0xFF) ^ 0xC3
    arena[43] = (seed + 0x71) & 0xFF

    result = long0 ^ tail_long
    result = (result + word0) & MASK32
    result ^= (arena[4] << 24) & MASK32
    result ^= (arena[5] << 16) & MASK32
    result = (result + arena[16]) & MASK32
    result ^= (arena[16 + dynamic] << 8) & MASK32
    result = (result + (arena[43] << 16)) & MASK32
    return result, arena


def far_memory_digest(arena):
    low = 0x4A39
    high = 0x6D2B
    for index, byte in enumerate(arena):
        low = (low * 33 + byte + index) & 0xFFFF
        high = (high * 257) & 0xFFFF
        high ^= ((byte << 8) | index) & 0xFFFF
    return (high << 16) | low


def emit_far_memory_matrix():
    signature = 0x16600111
    case_id = 0

    for actual in (48, 4, 6, 12, 16, 44):
        case_id += 1
        signature = signature_step(signature, case_id, actual)

    for expected_base in (0x00013FD0, 0x00043FD0):
        for offset in FAR_MEMORY_FORWARD_OFFSETS:
            actual = expected_base + offset
            for _ in range(3):
                case_id += 1
                signature = signature_step(signature, case_id, actual)
        for offset in FAR_MEMORY_RETREAT_OFFSETS:
            actual = expected_base + 48 - offset
            for _ in range(3):
                case_id += 1
                signature = signature_step(signature, case_id, actual)

    print("#define ABI_FAR_MEMORY_FORWARD_OFFSETS(X) \\")
    for index, offset in enumerate(FAR_MEMORY_FORWARD_OFFSETS, 1):
        suffix = " \\" if index != len(FAR_MEMORY_FORWARD_OFFSETS) else ""
        print(f"  X({index}, {offset}U){suffix}")
    print("#define ABI_FAR_MEMORY_RETREAT_OFFSETS(X) \\")
    for index, offset in enumerate(FAR_MEMORY_RETREAT_OFFSETS, 1):
        suffix = " \\" if index != len(FAR_MEMORY_RETREAT_OFFSETS) else ""
        print(f"  X({index}, {offset}U){suffix}")
    forward_cases = len(FAR_MEMORY_FORWARD_OFFSETS) * 3
    cases_per_page = forward_cases + len(FAR_MEMORY_RETREAT_OFFSETS) * 3
    print(f"#define ABI_FAR_MEMORY_FORWARD_CASES {forward_cases}U")
    print(f"#define ABI_FAR_MEMORY_CASES_PER_PAGE {cases_per_page}U")
    print(f"#define ABI_FAR_MEMORY_BOUNDARY_CASES {cases_per_page * 2}U")

    print("#define ABI_FAR_MEMORY_VECTORS(X) \\")
    for vector_id, seed in enumerate(FAR_MEMORY_SEEDS, 1):
        golden, final_arena = far_memory_apply(seed, far_memory_fill(seed))
        digest = far_memory_digest(final_arena)
        case_id += 1
        signature = signature_step(signature, case_id, golden)
        for _ in range(3):
            for actual in (golden, digest):
                case_id += 1
                signature = signature_step(signature, case_id, actual)

        page1 = far_memory_fill(seed)
        page4 = far_memory_fill(seed ^ 0x55AA)
        for offset in FAR_MEMORY_OFFSETS:
            for actual in (
                1, page1[offset], 1, page4[offset],
                1, page4[offset],
            ):
                case_id += 1
                signature = signature_step(signature, case_id, actual)

        suffix = " \\" if vector_id != len(FAR_MEMORY_SEEDS) else ""
        print(
            f"  X({vector_id}, 0x{seed:04x}U, 0x{golden:08x}UL){suffix}"
        )

    print("#define ABI_FAR_MEMORY_OFFSETS(X) \\")
    for index, offset in enumerate(FAR_MEMORY_OFFSETS, 1):
        suffix = " \\" if index != len(FAR_MEMORY_OFFSETS) else ""
        print(f"  X({index}, {offset}U){suffix}")
    print("#define ABI_FAR_MEMORY_CASES_PER_VECTOR 55U")
    print(f"#define ABI_FAR_MEMORY_SIGNATURE 0x{signature:08x}UL")


def far_automatic_apply(seed):
    seed &= 0xFFFF
    arena = bytearray(262)
    for index in range(len(arena)):
        arena[index] = (seed + index * 0x25 + 0x5B) & 0xFF

    def put_u16(offset, value):
        value &= 0xFFFF
        arena[offset] = value & 0xFF
        arena[offset + 1] = value >> 8

    def put_u32(offset, value):
        value &= MASK32
        put_u16(offset, value)
        put_u16(offset + 2, value >> 16)

    arena[0] = seed & 0xFF
    arena[1] = seed >> 8
    put_u16(2, seed ^ 0xA55A)
    arena[3] ^= ((seed >> 3) | 0x21) & 0xFF
    put_u32(14, 0x13579BDF ^ ((seed << 8) & MASK32))
    dynamic = (seed >> 4) & 0x7F
    arena[18 + dynamic] = (seed * 13 + 0x5B) & 0xFF
    arena[255] = ((seed >> 8) ^ 0xC3) & 0xFF
    put_u16(256, seed + 0x2468)
    put_u32(258, 0x89ABCDEF + seed)

    low = 0x4A39
    high = 0x6D2B
    for index, byte in enumerate(arena):
        low = (low * 33 + byte + index) & 0xFFFF
        high = (high * 257) & 0xFFFF
        high ^= ((byte << 8) | index) & 0xFFFF
    return ((high << 16) | low) & MASK32


def emit_far_automatic_matrix():
    signature = 0x16600112
    case_id = 1

    # The first nine layout checks produce these actual values.
    for actual in (262, 0, 1, 2, 14, 18, 256, 258, 270):
        signature = signature_step(signature, case_id, actual)
        case_id += 1

