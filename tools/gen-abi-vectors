def recursion_leaf(depth, seed):
    return ((seed ^ ((depth * 0x1111) & 0xFFFF)) + 0x2468) & 0xFFFF


def recursion_state_mix(depth, seed):
    depth &= 0xFFFF
    seed &= 0xFFFF
    words = [
        ((seed + depth * 0x0101 + index * 0x0123) ^
         (0xA55A + index * 0x1111)) & 0xFFFF
        for index in range(8)
    ]
    leaf = recursion_leaf(depth, seed)
    next_seed = (seed * 33 + depth * 0x0101 + 0x005B) & 0xFFFF
    child = (recursion_state_mix(depth - 1, next_seed)
             if depth else 0x13579BDF)
    result = (child ^ (seed << 16) ^ leaf) & MASK32
    for index in range(8):
        result = (result + ((words[index] << (index & 7)) & MASK32)) & MASK32
        result ^= (words[7 - index] * (index * 2 + 1)) & MASK32
    result ^= (leaf * 0x10001) & MASK32
    return ((result << 5) | (result >> 27)) & MASK32


