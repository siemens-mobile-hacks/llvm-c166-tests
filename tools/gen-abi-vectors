def integer32_results(a, b, count):
    a &= MASK32
    b &= MASK32
    count &= 31
    sa = signed_value(a, 32)
    sb = signed_value(b, 32)
    low_a = a & 0xFFFF
    low_b = b & 0xFFFF
    slow_a = signed_value(low_a, 16)
    slow_b = signed_value(low_b, 16)
    quotient = trunc_div(sa, sb)
    remainder = sa - quotient * sb
    results = [
        a + b,
        a - b,
        -a,
        a & b,
        a | b,
        a ^ b,
        ~a,
        a * b,
        a // b,
        a % b,
        slow_a * slow_b,
        quotient,
        remainder,
        a << count,
        a >> count,
        sa >> count,
        int(a == b),
        int(a != b),
        int(a < b),
        int(a <= b),
        int(a > b),
        int(a >= b),
        int(sa < sb),
        int(sa <= sb),
        int(sa > sb),
        int(sa >= sb),
        low_a,
        (a >> 16) & 0xFFFF,
        low_a,
        slow_a,
        (a & 0xFFFF0000) | low_b,
        low_a | ((low_b << 16) & MASK32),
        int(((a + b) & MASK32) < a),
        int(a < b),
        a if sa < sb else b,
        a if a > b else b,
    ]
    assert len(results) == INTEGER32_OP_COUNT
    return [value & MASK32 for value in results]


def emit_integer32_matrix():
    seed = 0x1660011A
    reference_signature = seed
    print("#define ABI_INTEGER32_VECTORS(X) \\")
    for vector_id, (a, b, count) in enumerate(INTEGER32_VECTORS, 1):
        suffix = " \\" if vector_id != len(INTEGER32_VECTORS) else ""
        print(
            f"  X({vector_id}, 0x{a:08x}UL, 0x{b:08x}UL, {count}U){suffix}"
        )
        for operation, actual in enumerate(integer32_results(a, b, count)):
            if operation in INTEGER32_HELPER_OPS:
                continue
            case_id = (vector_id - 1) * INTEGER32_OP_COUNT + operation + 1
            reference_signature = signature_step(
                reference_signature, case_id, actual
            )

    signature = signature_step(
        reference_signature, 0x1000, reference_signature
    )
    for vector_id, (a, b, count) in enumerate(INTEGER32_VECTORS, 1):
        for operation, actual in enumerate(integer32_results(a, b, count)):
            if operation in INTEGER32_HELPER_OPS:
                continue
            case_id = 0x2000 + (vector_id - 1) * INTEGER32_OP_COUNT + operation
            signature = signature_step(signature, case_id, actual)

    helper_cases = len(INTEGER32_VECTORS) * len(INTEGER32_HELPER_OPS)
    helper_index = 0
    print("#define ABI_INTEGER32_HELPER_GOLDENS(X) \\")
    for vector_id, (a, b, count) in enumerate(INTEGER32_VECTORS, 1):
        results = integer32_results(a, b, count)
        for operation in INTEGER32_HELPER_OPS:
            helper_index += 1
            case_id = 0x4000 + (vector_id - 1) * INTEGER32_OP_COUNT + operation
            actual = results[operation]
            signature = signature_step(signature, case_id, actual)
            suffix = " \\" if helper_index != helper_cases else ""
            print(
                f"  X(0x{case_id:04x}U, {operation}U, 0x{a:08x}UL, "
                f"0x{b:08x}UL, {count}U, 0x{actual:08x}UL){suffix}"
            )

    print(f"#define ABI_INTEGER32_OP_COUNT {INTEGER32_OP_COUNT}U")
    print(
        "#define ABI_INTEGER32_REFERENCE_SIGNATURE "
        f"0x{reference_signature:08x}UL"
    )
    print(f"#define ABI_INTEGER32_SIGNATURE 0x{signature:08x}UL")


def emit_clz32_matrix():
    signature = 0x1660011D
    print("#define ABI_CLZ32_VECTORS(X) \\")
    for vector_id, value in enumerate(CLZ32_VECTORS, 1):
        golden = 32 if value == 0 else 32 - value.bit_length()
        signature = signature_step(signature, vector_id, golden)
        suffix = " \\" if vector_id != len(CLZ32_VECTORS) else ""
        print(
            f"  X({vector_id}, 0x{value:08x}UL, {golden}UL){suffix}"
        )
    print(f"#define ABI_CLZ32_SIGNATURE 0x{signature:08x}UL")


def rotate_left(value, count):
    value &= MASK32
    return ((value << count) | (value >> (32 - count))) & MASK32


def control_flow_results(a, b, count):
    a &= MASK32
    b &= MASK32
    count &= 31
    sa = signed_value(a, 32)
    sb = signed_value(b, 32)
    low_a = signed_value(a, 16)

    and_hits = int((a & 0xFFFF) != 0)
    and_taken = and_hits and ((b & 0xFFFF) != 0)
    or_hits = int((a & 0xFFFF) == 0)
    or_taken = ((a & 0xFFFF) != 0) or ((b & 0xFFFF) != 0)
    chain_hits = 0
    chain_taken = False
    if (a & 0xFFFF) != 0:
        chain_hits += 1
        if (b & 0xFFFF) != 0:
            chain_hits += 1
            chain_taken = count != 0

    minimum = a if sa < sb else b
    maximum = a if sa > sb else b

    for_value = 0x13579BDF
    for index in range(count):
        for_value = rotate_left(for_value, 5) ^ (
            a + index * 0x00010001
        )
        for_value &= MASK32

    while_value = 0x2468ACE0
    index = 0
    while index < count:
        while_value = (rotate_left(while_value, 3) + (b ^ index)) & MASK32
        index += 1

    do_value = 0x0F0FF0F0
    index = 0
    while True:
        do_value = (rotate_left(do_value, 7) ^ (a + b + index)) & MASK32
        index += 1
        if index >= count:
            break

    dense = {
        -2: 0xD0020002,
        -1: 0xD0010001,
        0: 0xD0000000,
        1: 0xD1010001,
        2: 0xD2020002,
        3: 0xD3030003,
        4: 0xD4040004,
    }.get(low_a, 0xDFFF00FF)
    sparse = {
        -32768: 0xE0008000,
        -257: 0xE000FEFF,
        0: 0xE0000000,
        257: 0xE0000101,
        32767: 0xE0007FFF,
    }.get(low_a, 0xEFFF00FF)
    wide_switch = {
        0x00000000: 0xF0000000,
        0x00010000: 0xF0010000,
        0x7FFFFFFF: 0xF07FFFFF,
        0x80000000: 0xF0800000,
        0xFFFFFFFF: 0xF0FFFFFF,
    }.get(a, 0xF0ABCDEF)

    break_value = 0x10203040
    for index in range(count):
        if (index & 3) == 1:
            continue
        break_value = (break_value + (a ^ index)) & MASK32
        if (index & 7) == 6:
            break

    if sa < sb:
        nested = (a ^ 0x01010101) if count & 1 else (b ^ 0x02020202)
    elif a == b:
        nested = a ^ 0x03030303
    else:
        nested = (b ^ 0x04040404) if count & 1 else (a ^ 0x05050505)

    results = [
        (0x10000000 ^ a) if a == b else (0x20000000 ^ b),
        (0x30000000 ^ a) if a != b else (0x40000000 ^ b),
        (0x50000000 ^ a) if a < b else (0x60000000 ^ b),
        (0x70000000 ^ a) if a <= b else (0x71000000 ^ b),
        (0x72000000 ^ a) if a > b else (0x73000000 ^ b),
        (0x74000000 ^ a) if a >= b else (0x75000000 ^ b),
        (0x76000000 ^ a) if sa < sb else (0x77000000 ^ b),
        (0x78000000 ^ a) if sa <= sb else (0x79000000 ^ b),
        (0x7A000000 ^ a) if sa > sb else (0x7B000000 ^ b),
        (0x7C000000 ^ a) if sa >= sb else (0x7D000000 ^ b),
        ((0xA1000001 if and_taken else 0xA2000002) ^ (and_hits << 16)),
        ((0xA3000003 if or_taken else 0xA4000004) ^ (or_hits << 16)),
        ((0xA5000005 if chain_taken else 0xA6000006) ^ (chain_hits << 16)),
        (a ^ 0xB1000001) if a < b and count else
        ((b ^ 0xB2000002) if a < b else
         ((a ^ 0xB3000003) if count else (b ^ 0xB4000004))),
        minimum ^ rotate_left(maximum, 7),
        for_value,
        while_value,
        do_value,
        dense,
        sparse,
        wide_switch,
        break_value,
        (0xC1000001 ^ b) if (a & 0xFFFF) == 0 else (0xC2000002 ^ a),
        nested,
    ]
    assert len(results) == CONTROL_FLOW_OP_COUNT
    return [value & MASK32 for value in results]


