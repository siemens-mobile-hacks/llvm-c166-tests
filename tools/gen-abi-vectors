def varargs_matrix_mix(fixed, signed_value, unsigned_byte, enum_value,
                       word_value, long_value, long_long_value, pointed_value):
    weights = (1, 3, 5, 7, 11)
    fixed_mix = sum(value * weight for value, weight in zip(fixed, weights))
    value = (long_value + fixed_mix + signed_char(signed_value)) & MASK32
    value ^= (unsigned_byte & 0xFF) << 8
    value = (value + (enum_value & 0xFFFF) * 0x101) & MASK32
    value ^= (word_value & 0xFFFF) << 16
    value = (value + (pointed_value & 0xFFFF)) & MASK32
    long_long_value &= MASK32
    value ^= long_long_value
    value = (value + (((long_long_value << 7) & MASK32) |
                      (long_long_value >> 25))) & MASK32
    return value


def emit_varargs_matrix():
    print("#define ABI_VARARGS_MATRIX_VECTORS(X) \\")
    signature = 0x1660010C
    case_id = 0
    for index, values in enumerate(VARARGS_MATRIX_VECTORS, 1):
        fixed = values[:5]
        payload = values[5:]
        expected = [
            varargs_matrix_mix(fixed[:count], *payload)
            for count in range(1, 6)
        ]
        for golden in expected:
            for _ in range(3):
                case_id += 1
                signature = signature_step(signature, case_id, golden)
        suffix = " \\" if index != len(VARARGS_MATRIX_VECTORS) else ""
        print(
            f"  X({index}, "
            + ", ".join(f"0x{value:04x}U" for value in fixed)
            + f", (signed char)0x{payload[0]:02x}, "
            + f"(unsigned char)0x{payload[1]:02x}, "
            + f"(enum matrix_enum){payload[2]}, 0x{payload[3]:04x}U, "
            + f"0x{payload[4]:08x}UL, (abi_ull)0x{payload[5]:08x}UL, "
            + f"0x{payload[6]:04x}U, "
            + ", ".join(f"0x{value:08x}UL" for value in expected)
            + f"){suffix}"
        )

    print("#define ABI_VARARGS_STREAM_GOLDENS(X) \\")
    for prefix_count, pointed_value in enumerate(VARARGS_STREAM_POINTED):
        golden = varargs_stream_mix(prefix_count, pointed_value)
        for _ in range(3):
            case_id += 1
            signature = signature_step(signature, case_id, golden)
        suffix = " \\" if prefix_count + 1 != len(VARARGS_STREAM_POINTED) else ""
        print(
            f"  X({prefix_count}U, 0x{pointed_value:04x}U, "
            f"0x{golden:08x}UL){suffix}"
        )
    print(f"#define ABI_VARARGS_MATRIX_SIGNATURE 0x{signature:08x}UL")


def varargs_stream_mix(prefix_count, pointed_value):
    assert 0 <= prefix_count <= len(VARARGS_STREAM_PREFIXES)
    result = 0x6D2B79F5 ^ prefix_count
    for index, word in enumerate(VARARGS_STREAM_PREFIXES[:prefix_count]):
        result = rotate_left(result, 5)
        result ^= (word + index * 0x0101) & MASK32
    result = (result + VARARGS_STREAM_LONG0) & MASK32
    result ^= (VARARGS_STREAM_WORD0 << 16) & MASK32
    result = (rotate_left(result, 7) + VARARGS_STREAM_LONG1) & MASK32
    result ^= VARARGS_STREAM_WORD1
    result = (result + VARARGS_STREAM_LONG_LONG) & MASK32
    result ^= rotate_left(VARARGS_STREAM_LONG_LONG, 11)
    result = (result + pointed_value) & MASK32
    result ^= ((VARARGS_STREAM_TAIL << 16) | prefix_count) & MASK32
    return result & MASK32


def pair_r12_mix(pair, word14, byte15, stack0, stack1):
    value = pair & 0xFFFF
    value += ((pair >> 16) & 0xFFFF) * 3
    value += (word14 & 0xFFFF) * 5
    value += signed_char(byte15)
    value += (stack0 & 0xFFFF) * 7
    value += (stack1 & 0xFFFF) * 11
    value += ((stack1 >> 16) & 0xFFFF) * 13
    return value & 0xFFFF


