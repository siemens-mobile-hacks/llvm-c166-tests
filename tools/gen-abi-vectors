def aggregate_args_mix(seed):
    result = 0x4A39
    for size in range(1, 9):
        for index in range(size):
            byte = (seed + size * 0x11 + index * 0x23) & 0xFF
            tag = (size << 8) | index
            result = ((result << 5) | (result >> 11)) & 0xFFFF
            result ^= byte ^ tag
    return result


def emit_aggregate_args():
    print("#define ABI_AGGREGATE_ARG_VECTORS(X) \\")
    for index, seed in enumerate(AGGREGATE_ARG_SEEDS, 1):
        expected = aggregate_args_mix(seed)
        suffix = " \\" if index != len(AGGREGATE_ARG_SEEDS) else ""
        print(
            f"  X({index}, 0x{seed:02x}U, 0x{expected:04x}UL){suffix}"
        )


def emit_aggregate_return():
    print("#define ABI_AGGREGATE_RETURN_VECTORS(X) \\")
    for index, seed in enumerate(AGGREGATE_ARG_SEEDS, 1):
        expected = aggregate_args_mix(seed)
        arguments = [
            (seed + 0x0101) & 0xFFFF,
            seed ^ 0x2345,
            (seed + 0x4567) & 0xFFFF,
            seed ^ 0x6789,
            (seed + 0x89AB) & 0xFFFF,
            seed ^ 0xABCD,
            (seed + 0xCDEF) & 0xFFFF,
            seed ^ 0xFEDC,
        ]
        words = [
            (arguments[0] + arguments[4]) & 0xFFFF,
            (arguments[1] + arguments[5]) & 0xFFFF,
            (arguments[2] + arguments[6]) & 0xFFFF,
            (arguments[3] + arguments[7]) & 0xFFFF,
        ]
        tail = []
        for word in words:
            tail.extend((word & 0xFF, word >> 8))
        for tail_index, byte in enumerate(tail):
            expected = ((expected << 5) | (expected >> 11)) & 0xFFFF
            expected ^= byte ^ ((8 << 8) | tail_index)
        suffix = " \\" if index != len(AGGREGATE_ARG_SEEDS) else ""
        print(
            f"  X({index}, 0x{seed:02x}U, 0x{expected:04x}UL){suffix}"
        )


def aggregate_layout_mix(seed):
    seed &= 0xFFFF
    result = 0x6D2B
    values = []

    def u8(value):
        return value & 0xFF

    def combine(value, tag):
        nonlocal result
        result = ((result << 5) | (result >> 11)) & 0xFFFF
        result ^= value & 0xFFFF
        result ^= tag

    value = (u8(seed + 1) + u8(seed + 0x23) * 3 +
             u8(seed + 0x45) * 5 + (seed ^ 0x1111) * 7)
    values.append(value & 0xFFFF)
    combine(value, 0x0101)

    kind = 0xFFFF if seed & 1 else 0x1234
    value = (((seed + 0x0100) & 0xFFFF) * 3 + u8(seed + 0x12) * 5 +
             (seed ^ 0x2222) * 7 + u8(seed + 0x34) * 11 +
             kind * 13 + (seed ^ 0x3333) * 17)
    values.append(value & 0xFFFF)
    combine(value, 0x0202)

    value = (((seed + 0x0200) & 0xFFFF) * 3 +
             ((seed + 0x0300) & 0xFFFF) * 5 + u8(seed + 0x21) * 7 +
             u8(seed + 0x43) * 11 + (seed ^ 0x4444) * 13 +
             u8(seed + 0x65) * 17 + (seed ^ 0x5555) * 19)
    values.append(value & 0xFFFF)
    combine(value, 0x0303)

    value = (((seed + 0x0500) & 0xFFFF) * 3 +
             ((seed + 0x0600) & 0xFFFF) * 5 +
             ((seed + 0x0700) & 0xFFFF) * 7 +
             ((seed + 0x0400) & 0xFFFF) * 11 +
             (seed ^ 0x6666) * 13 + (seed ^ 0x7777) * 17)
    values.append(value & 0xFFFF)
    combine(value, 0x0404)

    value = (u8(seed + 0x31) * 3 + (seed ^ 0x8888) * 5 +
             u8(seed + 0x53) * 7 + (seed ^ 0x9999) * 11)
    values.append(value & 0xFFFF)
    combine(value, 0x0505)

    first = seed & 7
    second = (seed >> 3) & 31
    third = (seed ^ 0x00A6) & 0xFF
    fourth = (seed >> 8) & 1
    value = (((seed + 0x0A00) & 0xFFFF) * 3 +
             ((seed + 0x0B00) & 0xFFFF) * 5 +
             ((seed + 0x0C00) & 0xFFFF) * 7 + first * 11 +
             second * 13 + third * 17 + fourth * 19 +
             (seed ^ 0xAAAA) * 23)
    values.append(value & 0xFFFF)
    combine(value, 0x0606)

    bits7_10_first = seed & 0x007F
    bits7_10_second = (seed ^ 0x0155) & 0x03FF
    bits9_8_first = (seed ^ 0x0123) & 0x01FF
    bits9_8_second = (seed ^ 0x00A5) & 0x00FF
    bits15_2_first = (seed ^ 0x4567) & 0x7FFF
    bits15_2_second = (seed >> 6) & 0x0003
    bits1_16_first = (seed >> 15) & 0x0001
    bits1_16_second = seed ^ 0xBEEF
    value = (bits7_10_first * 3 + bits7_10_second * 5 +
             bits9_8_first * 7 + bits9_8_second * 11 +
             bits15_2_first * 13 + bits15_2_second * 17 +
             bits1_16_first * 19 + bits1_16_second * 23 +
             (seed ^ 0xCAFE) * 29)
    values.append(value & 0xFFFF)
    combine(value, 0x0707)

    zero_first = seed & 0x0007
    zero_second = (seed >> 3) & 0x001F
    signed_first = (-((seed & 0x0003) + 1)) & 0xFFFF
    signed_second = (-(((seed >> 2) & 0x00FF) + 1)) & 0xFFFF
    signed_third = (seed >> 10) & 0x000F
    leading_head = u8(seed + 0x17)
    leading_first = (seed ^ 0x0035) & 0x007F
    leading_second = (seed ^ 0x0155) & 0x03FF
    trailing_first = (seed ^ 0x0027) & 0x007F
    trailing_second = (seed ^ 0x0123) & 0x01FF
    trailing_tail = u8(seed + 0x39)
    value = (((seed + 0x0D00) & 0xFFFF) * 3 +
             ((seed + 0x0E00) & 0xFFFF) * 5 + zero_first * 7 +
             zero_second * 11 + signed_first * 13 + signed_second * 17 +
             signed_third * 19 + leading_head * 23 + leading_first * 29 +
             leading_second * 31 + trailing_first * 37 +
             trailing_second * 41 + trailing_tail * 43 +
             (seed ^ 0xDADA) * 47)
    values.append(value & 0xFFFF)
    combine(value, 0x0808)

    value = (((seed + 0x0F00) & 0xFFFF) * 3 + u8(seed + 0x41) * 5 +
             u8(seed + 0x52) * 7 + (seed ^ 0x1357) * 11 +
             u8(seed + 0x63) * 13 + u8(seed + 0x74) * 17 +
             u8(seed + 0x85) * 19 + (seed ^ 0x2468) * 23 +
             u8(seed + 0x96) * 29 + (seed ^ 0x369C) * 31 +
             u8(seed + 0xA7) * 37 + u8(seed + 0xB8) * 41 +
             u8(seed + 0xC9) * 43 + u8(seed + 0xDA) * 47 +
             u8(seed + 0xEB) * 53 + u8(seed + 0xFC) * 59 +
             (seed ^ 0xEBCD) * 61)
    values.append(value & 0xFFFF)
    combine(value, 0x0909)
    return result, values


def emit_aggregate_layout():
    signature = 0x1660010B
    print("#define ABI_AGGREGATE_LAYOUT_VECTORS(X) \\")
    for index, seed in enumerate(AGGREGATE_LAYOUT_SEEDS, 1):
        expected, values = aggregate_layout_mix(seed)
        suffix = " \\" if index != len(AGGREGATE_LAYOUT_SEEDS) else ""
        print(
            f"  X({index}, 0x{seed:04x}U, "
            + ", ".join(f"0x{value:04x}UL" for value in values)
            + f", 0x{expected:04x}UL){suffix}"
        )
        for selection, selection_expected in enumerate([*values, expected]):
            for direction in range(3):
                case_id = (index - 1) * 30 + selection * 3 + direction + 1
                signature = signature_step(signature, case_id,
                                           selection_expected)
    print(f"#define ABI_AGGREGATE_LAYOUT_SIGNATURE 0x{signature:08x}UL")


def aggregate_varargs_mix(seed):
    def u8(value):
        return value & 0xFF

    return (
        0x1357 * 3 +
        (seed ^ 0x1111) * 5 +
        ((seed + 0x2222) & 0xFFFF) * 7 +
        u8(seed + 0x01) * 11 +
        u8(seed + 0x23) * 13 +
        u8(seed + 0x45) * 17 +
        u8(seed + 0x67) * 19 +
        (seed ^ 0x8888) * 23 +
        (seed ^ 0xCAFE) * 29
    ) & 0xFFFF


def emit_aggregate_varargs():
    signature = 0x16600131
    print("#define ABI_AGGREGATE_VARARGS_VECTORS(X) \\")
    for index, seed in enumerate(AGGREGATE_VARARGS_SEEDS, 1):
        expected = aggregate_varargs_mix(seed)
        repeated = expected | (expected << 16)
        suffix = " \\" if index != len(AGGREGATE_VARARGS_SEEDS) else ""
        print(
            f"  X({index}, 0x{seed:04x}U, 0x{expected:04x}U, "
            f"0x{repeated:08x}UL){suffix}"
        )
        base = (index - 1) * 3
        signature = signature_step(signature, base + 1, expected)
        signature = signature_step(signature, base + 2, expected)
        signature = signature_step(signature, base + 3, repeated)
    print(f"#define ABI_AGGREGATE_VARARGS_SIGNATURE 0x{signature:08x}UL")


