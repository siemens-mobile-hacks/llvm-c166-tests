def multi_epilog_mix(values, mode, rounds):
    addends = (0x00010001, 0x01020304, 0x10203040,
               0x7FFF0001, 0x8000FFFF, 0xFEDCBA98)
    if mode == 0xFFFF:
        return (values[0] ^ values[5]) & MASK32

    live = [
        (value + addend) & MASK32
        for value, addend in zip(values, addends)
    ]
    gate = mode & 0xFFFF
    if gate == 0:
        return (live[0] ^ live[5]) & MASK32

    accumulator = (live[0] + (live[1] ^ live[5])) & MASK32
    for index in range(rounds & 0xFFFF):
        step = (gate + index) & 7
        selected = live[(index + step) % 6]
        accumulator = (
            ((accumulator << 5) | (accumulator >> 27)) ^ selected
        ) & MASK32
        accumulator = (
            accumulator + step * 0x10001 + index
        ) & MASK32
        if step == 7:
            return (accumulator ^ live[4]) & MASK32

    if gate & 1:
        return (accumulator + live[1] + live[3]) & MASK32
    if gate & 2:
        return (accumulator ^ live[2] ^ live[5]) & MASK32
    return (accumulator + live[4]) & MASK32


