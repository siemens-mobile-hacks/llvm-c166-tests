def word_matrix_mix(values, count):
    result = 0xA5A50000 ^ (count * 0x01010101)
    for index, value in enumerate(values[:count]):
        result = (result + ((value & 0xFFFF) << (index + 1))) & MASK32
        result ^= ((value & 0xFFFF) << (15 - index)) & MASK32
    return result & MASK32


def signature_step(signature, case_id, actual):
    tag = ((case_id & 0xFFFF) << 16) | (case_id & 0xFFFF)
    signature = ((signature << 5) | (signature >> 27)) & MASK32
    return (signature ^ (actual & MASK32) ^ tag) & MASK32


