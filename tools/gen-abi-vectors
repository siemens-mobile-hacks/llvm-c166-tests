def varargs_mix(fixed0, fixed1, signed_value, unsigned_value, long_value,
                pointed_value):
    value = (long_value + ((fixed0 & 0xFFFF) << 16)) & MASK32
    value ^= fixed1 & 0xFFFF
    value = (value + signed_char(signed_value)) & MASK32
    value ^= (unsigned_value & 0xFFFF) << 16
    value = (value + (pointed_value & 0xFFFF)) & MASK32
    return value


