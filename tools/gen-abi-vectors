def signed_value(value, bits):
    mask = (1 << bits) - 1
    value &= mask
    sign = 1 << (bits - 1)
    return value - (1 << bits) if value & sign else value


def trunc_div(lhs, rhs):
    quotient = abs(lhs) // abs(rhs)
    return -quotient if (lhs < 0) != (rhs < 0) else quotient


def integer16_results(a, b, count):
    a &= 0xFFFF
    b &= 0xFFFF
    count &= 15
    sa = signed_value(a, 16)
    sb = signed_value(b, 16)
    ua8 = a & 0xFF
    ub8 = b & 0xFF
    sa8 = signed_value(ua8, 8)
    sb8 = signed_value(ub8, 8)
    quotient = trunc_div(sa, sb)
    remainder = sa - quotient * sb
    results = [
        (a + b) & 0xFFFF,
        (a - b) & 0xFFFF,
        (-a) & 0xFFFF,
        a & b,
        a | b,
        a ^ b,
        (~a) & 0xFFFF,
        (a * b) & 0xFFFF,
        a // b,
        a % b,
        (a << count) & 0xFFFF,
        a >> count,
        quotient,
        remainder,
        sa >> count,
        int(a == b),
        int(a != b),
        int(a < b),
        int(a <= b),
        int(a > b),
        int(a >= b),
        int(sa < sb),
        int(sa <= sb),
        int(sa > sb),
        int(sa >= sb),
        ua8 + ub8,
        sa8 + sb8,
        ua8,
        sa8,
        ua8,
        sa8,
        (a & 0xFF00) | ub8,
        (a >> 8) & 0xFF,
        signed_value((a >> 8) & 0xFF, 8),
        sa8 * sb8,
        -sa,
        sa + sb,
        sa - sb,
        trunc_div(sa8 * sb8, 6) + (sa8 - sb8),
    ]
    assert len(results) == INTEGER16_OP_COUNT
    return [value & MASK32 for value in results]


def emit_integer16_matrix():
