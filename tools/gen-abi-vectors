def emit_indirect_matrix():
    a, b, c, d, e = INDIRECT_MATRIX_VECTOR
    golden0 = 0x13572468
    golden2 = 0x24680000 ^ (a << 16) ^ b
    golden5 = 0x5A5A0000
    golden5 = (golden5 + a) & MASK32
    golden5 ^= (b << 16) & MASK32
    golden5 = (golden5 + (c << 1)) & MASK32
    golden5 ^= d
    golden5 = (golden5 + (e << 16)) & MASK32
    signature = 0x1660010E
    case_id = 0
    for golden in (golden0, golden2, golden5):
        for actual in (golden, golden, 1, 1, golden, golden):
            case_id += 1
            signature = signature_step(signature, case_id, actual)
    print(
        "#define ABI_INDIRECT_MATRIX_VECTOR(X) \\\n"
        f"  X(0x{a:04x}U, 0x{b:04x}U, 0x{c:04x}U, 0x{d:04x}U, "
        f"0x{e:04x}U, 0x{golden0:08x}UL, 0x{golden2:08x}UL, "
        f"0x{golden5:08x}UL)"
    )
    print(f"#define ABI_INDIRECT_MATRIX_SIGNATURE 0x{signature:08x}UL")


def mixed_slot_mix(tag, prefix_count, value, tail):
    prefixes = MIXED_SLOT_INPUT["prefixes"]
    used = prefixes[:prefix_count] + (0,) * (4 - prefix_count)
    low = tag ^ ((used[0] << 1) & 0xFFFF)
    low ^= (used[2] << 3) & 0xFFFF
    low ^= value & 0xFFFF
    high = 0x6D2B ^ tag ^ used[1]
    high ^= (used[3] << 8) & 0xFFFF
    high ^= (value >> 16) & 0xFFFF
    low = (low + tail) & 0xFFFF
    high = (high + tail) & 0xFFFF
    return (high << 16) | low


def emit_mixed_slot_matrix():
    prefixes = MIXED_SLOT_INPUT["prefixes"]
    signed_value = signed_char(MIXED_SLOT_INPUT["signed_byte"]) & MASK32
    unsigned_value = MIXED_SLOT_INPUT["unsigned_byte"]
    long_value = MIXED_SLOT_INPUT["long"]
    pointed_value = MIXED_SLOT_INPUT["pointed"]
    tail = MIXED_SLOT_INPUT["tail"]
    shapes = []
    shapes.extend((count, signed_value) for count in range(5))
    shapes.extend((count, unsigned_value) for count in range(5))
    shapes.extend((count, long_value) for count in range(4))
    shapes.extend((count, pointed_value) for count in range(4))
    for count in range(4):
        callback_value = (tail ^ (18 + count) ^ 0x5AA5) & 0xFFFF
        shapes.append((count, callback_value))

    goldens = [
        mixed_slot_mix(tag, prefix_count, value, tail)
        for tag, (prefix_count, value) in enumerate(shapes)
    ]
    signature = 0x1660010F
    case_id = 0
    for golden in goldens:
        for actual in (golden, golden, golden):
            case_id += 1
            signature = signature_step(signature, case_id, actual)
    enum_goldens = [
        sum((value & 0xF) << (index * 4)
            for index, value in enumerate(vector))
        for vector in ENUM_SLOT_VECTORS
    ]
    for golden in enum_goldens:
        for actual in (golden, golden, golden):
            case_id += 1
            signature = signature_step(signature, case_id, actual)

    print(f"#define ABI_MIXED_SLOT_P0 0x{prefixes[0]:04x}U")
    print(f"#define ABI_MIXED_SLOT_P1 0x{prefixes[1]:04x}U")
    print(f"#define ABI_MIXED_SLOT_P2 0x{prefixes[2]:04x}U")
    print(f"#define ABI_MIXED_SLOT_P3 0x{prefixes[3]:04x}U")
    print(
        f"#define ABI_MIXED_SLOT_S8 (abi_s8)0x{MIXED_SLOT_INPUT['signed_byte']:02x}"
    )
    print(
        f"#define ABI_MIXED_SLOT_U8 (abi_u8)0x{MIXED_SLOT_INPUT['unsigned_byte']:02x}"
    )
    print(f"#define ABI_MIXED_SLOT_U32 0x{long_value:08x}UL")
    print(f"#define ABI_MIXED_SLOT_CELL 0x{pointed_value:04x}U")
    print(f"#define ABI_MIXED_SLOT_TAIL 0x{tail:04x}U")
    print("#define ABI_MIXED_SLOT_GOLDENS(X) \\")
    for tag, golden in enumerate(goldens):
        suffix = " \\" if tag != len(goldens) - 1 else ""
        print(f"  X({tag}, 0x{golden:08x}UL){suffix}")
    print("#define ABI_ENUM_SLOT_VECTORS(X) \\")
    for vector_id, (vector, golden) in enumerate(
            zip(ENUM_SLOT_VECTORS, enum_goldens), 1):
        suffix = " \\" if vector_id != len(ENUM_SLOT_VECTORS) else ""
        values = ", ".join(str(value) for value in vector)
        print(
            f"  X({vector_id}, {values}, 0x{golden:08x}UL){suffix}"
        )
    print(f"#define ABI_MIXED_SLOT_SIGNATURE 0x{signature:08x}UL")


