#!/usr/bin/env bash
set -euo pipefail

project_root=${C166_TEST_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}
optimization=${1:-O2}
iterations=${C166_INTEGER_STRESS_ITERATIONS:-640}
seed_list=${C166_INTEGER_STRESS_SEEDS:-0x00000001,0x1660c166,0xdeadbeef}
temp_root=${C166_TEST_TMP_ROOT:-/tmp/codex}

[[ ${optimization} =~ ^O(0|1|2|3|s|z)$ ]] || {
  echo "invalid optimization: ${optimization}" >&2
  exit 2
}
[[ ${iterations} =~ ^[1-9][0-9]*$ ]] || {
  echo "invalid C166_INTEGER_STRESS_ITERATIONS: ${iterations}" >&2
  exit 2
}
IFS=, read -r -a seeds <<<"${seed_list}"
((${#seeds[@]} > 0)) || {
  echo "C166_INTEGER_STRESS_SEEDS is empty" >&2
  exit 2
}

checks=$((${#seeds[@]} * iterations * 54))
if ((checks < 100000)); then
  echo "stress configuration has only ${checks} checks; require at least 100000" >&2
  exit 2
fi

mkdir -p "${temp_root}"
case_dir=$(mktemp -d "${temp_root}/c166-seeded-integer-stress.XXXXXXXX")
trap 'rm -rf -- "${case_dir}"' EXIT
prepare=(
  "${project_root}/tools/prepare-seeded-integer-case"
  --output "${case_dir}"
  --template "${project_root}/tests/stress/seeded-integer-differential"
  --optimization "${optimization}"
  --iterations "${iterations}"
)
for seed in "${seeds[@]}"; do
  prepare+=(--seed "${seed}")
done
"${prepare[@]}" >/dev/null

echo "C166 seeded integer stress: ${checks} checks, ${#seeds[@]} seeds, ${iterations} iterations"
C166_TEST_ROOT="${project_root}" "${project_root}/harness/run-sim" \
  "${case_dir}" seeded-integer-stress "${optimization}"
