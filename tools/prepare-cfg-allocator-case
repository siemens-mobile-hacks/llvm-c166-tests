#!/usr/bin/env python3
"""Materialize a canonical generated-CFG case for one register allocator."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil


COPIED_FILES = (
    "corpus.inc", "expected.dis", "host.c", "llvm.c", "selector.c", "types.h",
)
ALLOCATORS = ("basic", "greedy", "fast")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--template", required=True, type=Path)
    parser.add_argument("--allocator", choices=ALLOCATORS, required=True)
    args = parser.parse_args()
    if args.output.exists() and any(args.output.iterdir()):
        parser.error("--output must not contain existing files")

    args.output.mkdir(parents=True, exist_ok=True)
    for name in COPIED_FILES:
        shutil.copyfile(args.template / name, args.output / name)

    manifest = json.loads(
        (args.template / "case.json").read_text(encoding="utf-8"))
    manifest["extra_clang_flags"] += [
        "-mllvm", f"-regalloc={args.allocator}",
    ]
    manifest["labels"] = sorted(set(manifest["labels"] + [
        "alternate-allocator", args.allocator, "runner-variant",
    ]))
    manifest["generation"]["allocator"] = args.allocator
    manifest["generation"]["template"] = "generated-cfg-pressure"
    (args.output / "case.json").write_text(
        json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
