[[ "$manifest_signature" == "$expected_signature" ]] || {
  echo "float64 conversion manifest signature drift: expected ${expected_signature}, got ${manifest_signature}" >&2
  exit 1
}

diff -u "${project_root}/tests/differential/float-width-matrix/vectors.inc" \
  <("${project_root}/tools/gen-float-width-vectors" vectors)
expected_signature="$("${project_root}/tools/gen-float-width-vectors" \
  manifest-signature)"
manifest_signature="$(jq -er '.result.expected_signature' \
