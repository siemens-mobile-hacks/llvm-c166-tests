manifest_signature="$(jq -er '.result.expected_signature' \
  "${project_root}/tests/abi/abi-mixed-recursion/case.json")"
[[ "$manifest_signature" == "$expected_signature" ]] || {
  echo "mixed recursion manifest signature drift: expected ${expected_signature}, got ${manifest_signature}" >&2
  exit 1
}

