diff -u "${project_root}/tests/differential/float32-storage-matrix/vectors.inc" \
  <("${project_root}/tools/gen-float32-storage-vectors" vectors)
expected_signature="$(${project_root}/tools/gen-float32-storage-vectors \
  manifest-signature)"
manifest_signature="$(jq -er '.result.expected_signature' \
