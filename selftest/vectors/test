  exit 1
}

diff -u "${project_root}/tests/differential/float64-storage-matrix/vectors.inc" \
  <("${project_root}/tools/gen-float64-storage-vectors" vectors)
expected_signature="$("${project_root}/tools/gen-float64-storage-vectors" \
  manifest-signature)"
manifest_signature="$(jq -er '.result.expected_signature' \
  "${project_root}/tests/differential/float64-storage-matrix/case.json")"
[[ "$manifest_signature" == "$expected_signature" ]] || {
  echo "float64 storage manifest signature drift: expected ${expected_signature}, got ${manifest_signature}" >&2
  exit 1
