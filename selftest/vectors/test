  exit 1
}

diff -u "${project_root}/tests/differential/float32-conversion-matrix/vectors.inc" \
  <("${project_root}/tools/gen-float32-conversion-vectors" vectors)
diff -u <(sed -n \
    '/^; Generated by tools\/gen-float32-conversion-vectors\.$/,/^; END GENERATED FLOAT VALUES$/p' \
    "${project_root}/tests/differential/float32-conversion-matrix/abi-boundary.asm" | sed '$d') \
  <("${project_root}/tools/gen-float32-conversion-vectors" asm)
expected_signature="$(${project_root}/tools/gen-float32-conversion-vectors \
  manifest-signature)"
manifest_signature="$(jq -er '.result.expected_signature' \
  "${project_root}/tests/differential/float32-conversion-matrix/case.json")"
[[ "$manifest_signature" == "$expected_signature" ]] || {
  echo "float32 conversion manifest signature drift: expected ${expected_signature}, got ${manifest_signature}" >&2
  exit 1
}

aggregate_generator="${project_root}/tools/gen-aggregate-shape-corpus"
aggregate_case="${project_root}/tests/abi/abi-generated-aggregate"
for mode in corpus vectors; do
  diff -u "${aggregate_case}/${mode}.inc" <("$aggregate_generator" "$mode")
done
diff -u "${aggregate_case}/shape-spec.json" \
  <("$aggregate_generator" spec)
expected_signature="$("$aggregate_generator" manifest-signature)"
manifest_signature="$(jq -er '.result.expected_signature' \
  "${aggregate_case}/case.json")"
[[ "$manifest_signature" == "$expected_signature" ]] || {
  echo "aggregate shape manifest signature drift: expected ${expected_signature}, got ${manifest_signature}" >&2
  exit 1
}
