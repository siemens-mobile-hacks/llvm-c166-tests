#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${project_root}/harness/common.sh"
source "${project_root}/harness/linker/image.sh"

fixture="${C166_TEST_ARTIFACT_ROOT:-${project_root}/build}/selftest-image"
case_dir="${fixture}/case"
run_dir="${fixture}/run"
mkdir -p "$case_dir" "$run_dir"
cat >"${run_dir}/llvm.nm" <<'EOF'
00100000 T __c166_test_overlay_entry
0017ff00 T __icall
00180100 T _required
EOF
cat >"${run_dir}/llvm.dis" <<'EOF'
00100000 <__c166_test_overlay_entry>:
  calls 11, 0
  calls 11, 0
EOF
printf '_required\n' >"${case_dir}/expected.nm"
printf 'calls 11, 0\n' >"${case_dir}/expected.dis"
cat >"${case_dir}/case.json" <<'EOF'
{"disassembly_min_counts":[{"pattern":"calls 11, 0","min":2}]}
EOF

declare -A config=(
  [icall_start]=0x17ff00
  [overlay_entry]=0x100000
  [entry_symbol]=__c166_test_overlay_entry
)
required=(_required)
c166_verify_llvm_image "$run_dir" "$case_dir" large \
  "${case_dir}/case.json" config required \
  "${project_root}/tools/check-required-symbols"

sed -i '/_required/d' "${run_dir}/llvm.nm"
if (c166_verify_llvm_image "$run_dir" "$case_dir" large \
      "${case_dir}/case.json" config required \
      "${project_root}/tools/check-required-symbols") >/dev/null 2>&1; then
  echo "image verifier accepted a missing required symbol" >&2
  exit 1
fi

echo "C166 ELF image self-test passed"
