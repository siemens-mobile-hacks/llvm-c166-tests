#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
wrapper="${project_root}/tools/with-headless-x"

actual="$(DISPLAY=:777 WAYLAND_DISPLAY=wayland-777 \
  DBUS_SESSION_BUS_ADDRESS=unix:path=/desktop-bus \
  "$wrapper" bash -c '
    [[ "${C166_HEADLESS_X_ACTIVE:-0}" == 1 ]]
    [[ "${DISPLAY:-}" == :* && "${DISPLAY}" != :777 ]]
    [[ -n "${XAUTHORITY:-}" && -f "${XAUTHORITY}" ]]
    [[ -z "${WAYLAND_DISPLAY+x}" ]]
    [[ -z "${DBUS_SESSION_BUS_ADDRESS+x}" ]]
    xdpyinfo -display "${DISPLAY}" >/dev/null
    printf "%s\n" "${DISPLAY}"
  ')"

[[ "$actual" == :* ]]
