#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
wrapper="${project_root}/tools/with-noninteractive-wine"
sentinel_display="${DISPLAY-__unset__}"
sentinel_wayland="${WAYLAND_DISPLAY-__unset__}"

actual="$($wrapper bash -c 'printf "%s\n%s\n%s\n%s\n" \
  "${DISPLAY-__unset__}" "${WAYLAND_DISPLAY-__unset__}" \
  "$WINEDEBUG" "$WINEDLLOVERRIDES"')"

mapfile -t values <<<"$actual"
[[ "${values[0]}" == "$sentinel_display" ]]
[[ "${values[1]}" == "$sentinel_wayland" ]]
[[ "${values[2]}" == "-all" ]]
[[ "${values[3]}" == "winemenubuilder.exe=d" ]]

if rg -qi 'xvfb|xvfb-run|C166_HEADLESS_X' "$wrapper"; then
  echo "noninteractive Wine wrapper still contains virtual-X machinery" >&2
  exit 1
fi
