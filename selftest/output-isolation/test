#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
start_ns="$(date +%s%N)"
output="$(
  "${project_root}/tools/with-isolated-output" \
    bash -c 'sleep 3 & printf "%s\n" isolated-output-ok'
)"
end_ns="$(date +%s%N)"
elapsed_ns="$((end_ns - start_ns))"

[[ "$output" == isolated-output-ok ]] || {
  echo "unexpected captured output: ${output}" >&2
  exit 1
}
((elapsed_ns < 2000000000)) || {
  echo "output wrapper waited for background descendant: ${elapsed_ns} ns" >&2
  exit 1
}
