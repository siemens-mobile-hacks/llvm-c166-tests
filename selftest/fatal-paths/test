#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
llvm_root="${LLVM_SOURCE:-${project_root}/../llvm-project}"
checker="${project_root}/tools/check-c166-fatal-paths"
inventory="${project_root}/oracle/robustness/fatal-paths.json"

"${checker}" --llvm-project "${llvm_root}" --inventory "${inventory}" >/dev/null

temp_root="${TMPDIR:-/tmp}/llvm-c166-tests"
mkdir -p "${temp_root}"
test_root="$(mktemp -d "${temp_root}/c166-fatal-paths.XXXXXX")"
cleanup() {
  case "${test_root}" in
    "${temp_root}"/c166-fatal-paths.*) rm -rf -- "${test_root}" ;;
    *) echo "refusing to remove unexpected test path: ${test_root}" >&2 ;;
  esac
}
trap cleanup EXIT

mkdir -p "${test_root}/llvm/lib/Target"
cp -a "${llvm_root}/llvm/lib/Target/C166" "${test_root}/llvm/lib/Target/C166"
perl -0pi -e 's!\n\z!\nnamespace { void unreviewed_fatal_path() { assert(false && "unreviewed C166 fatal path"); } }\n!' \
  "${test_root}/llvm/lib/Target/C166/C166Subtarget.cpp"

if "${checker}" --llvm-project "${test_root}" \
    --inventory "${inventory}" >/dev/null 2>&1; then
  echo "fatal-path checker accepted an unreviewed source site" >&2
  exit 1
fi

echo "C166 fatal-path checker self-test passed (baseline + unreviewed drift)"
