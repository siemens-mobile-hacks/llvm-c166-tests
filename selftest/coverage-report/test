#!/usr/bin/env bash
set -euo pipefail

project_root="${C166_TEST_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}"
source "${project_root}/harness/common.sh"

run_dir="$(c166_new_run_dir coverage-report)"
"${project_root}/tools/generate-coverage-report" --output-dir "${run_dir}"

report="${run_dir}/coverage.json"
[[ -f "$report" ]] || c166_die "coverage.json was not generated"
[[ -f "${run_dir}/coverage.md" ]] || c166_die "coverage.md was not generated"

jq -e '
  .schema_version == 2 and
  .scope == "retained_crossview_iss_pass_evidence" and
  .summary.manifests == 89 and
  .summary.configurations == 751 and
  .summary.configurations == .summary.passing_configurations and
  .summary.latest_passing_configurations == .summary.configurations and
  .models.large.manifests == 79 and
  .models.large.configurations == 405 and
  .models.large.configurations == .models.large.passing_configurations and
  .models.large.latest_passing_configurations == .models.large.configurations and
  .models.medium.manifests == 37 and
  .models.medium.configurations == 195 and
  .models.medium.passing_configurations == 195 and
  .models.medium.latest_passing_configurations == 195 and
  ([.configurations[] | select(.model == "medium")] | length) == 195 and
  .models.small.manifests == 27 and
  .models.small.configurations == 151 and
  .models.small.passing_configurations == 151 and
  .models.small.latest_passing_configurations == 151 and
  ([.configurations[] | select(.model == "small")] | length) == 151 and
  .model_abi.large.verified == 63 and
  .model_abi.large.evidence_backed == 63 and
  .model_abi.medium.verified == 20 and
  .model_abi.medium.evidence_backed == 16 and
  .model_abi.medium.structural_only == 4 and
  .model_abi.medium.covered == 20 and
  .model_abi.small.verified == 18 and
  .model_abi.small.evidence_backed == 15 and
  .model_abi.small.structural_only == 3 and
  .model_abi.small.covered == 18 and
  .gaps.model_abi_facts_without_pass == [] and
  .summary.runner_variants >= 6 and
  .summary.runner_variants == .summary.passing_runner_variants and
  .summary.abi_facts_verified >= 60 and
  .summary.abi_facts_evidence_backed == .summary.abi_facts_verified and
  .summary.branch_paths == 33 and
  .summary.branch_paths_both_outcomes == 33 and
  .branch_paths.evidence_backed == true and
  .branch_paths.switch_gaps == {} and
  .summary.postra_pseudos_expected == 56 and
  .summary.postra_pseudos_observed == 56 and
  .pseudo_provenance.complete == true and
  .pseudo_provenance.surviving_after == [] and
  .pseudo_provenance.pipeline_unreachable == ["FLAGSBR", "SHL32ri4"] and
  .crossview_dynamic_coverage.status == "not_probed" and
  .crossview_dynamic_coverage.usable_for_llvm_overlay == false and
  .summary.opcode_families_executed > 0 and
  .summary.relocation_families_executed > 0 and
  .summary.codegen_opcode_families_expected ==
    .summary.codegen_opcode_families_executed and
  .summary.codegen_relocation_families_expected ==
    .summary.codegen_relocation_families_executed and
  ([.configurations[] |
    select(.case == "generated-type-semantics" and .pass != null)] | length) == 6
' "$report" >/dev/null || c166_die "coverage report invariants failed: ${report}"

echo "retained ISS coverage report self-test passed; artifacts=${run_dir}"
