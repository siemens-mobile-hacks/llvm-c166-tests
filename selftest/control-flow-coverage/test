#!/usr/bin/env bash
set -euo pipefail

project_root="${C166_TEST_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}"
case_dir="${project_root}/tests/differential/control-flow-matrix"

"${project_root}/tools/check-control-flow-path-coverage"
oracle_output="$("${project_root}/tools/gen-control-flow-signatures")"
reference="$(sed -n 's/^reference=0x//p' <<<"$oracle_output")"
final="$(sed -n 's/^final=0x//p' <<<"$oracle_output")"
vectors="$(sed -n 's/^vectors=//p' <<<"$oracle_output")"

[[ "$reference" =~ ^[0-9a-f]{8}$ && "$final" =~ ^[0-9a-f]{8}$ ]] || {
  echo "invalid signature oracle output: ${oracle_output}" >&2
  exit 1
}
rg -q "ABI_CONTROL_FLOW_REFERENCE_SIGNATURE 0x${reference}UL" \
  "${case_dir}/vectors.inc"
rg -q "ABI_CONTROL_FLOW_SIGNATURE 0x${final}UL" "${case_dir}/vectors.inc"
expected_decimal="$((16#${final}))"
manifest_signature="$(jq -r '.result.expected_signature' "${case_dir}/case.json")"
[[ "$manifest_signature" == "$expected_decimal" ]]
[[ "$vectors" == 17 ]]

echo "control-flow path/signature oracle passed: 33/33 branches, 3 switches, ${vectors} vectors"
