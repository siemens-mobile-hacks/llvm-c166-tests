#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
parent="${C166_TEST_ARTIFACT_ROOT:-${project_root}/build}/selftest-reducer"
mkdir -p "$parent"
output="$(mktemp -d "${parent}/run.XXXXXXXX")"

"${project_root}/tools/reduce-aggregate-shape-failure" \
  "${project_root}/selftest/reducer/failure.log" \
  "${output}/failure-reproducer" \
  "${project_root}/tests/abi/abi-generated-aggregate" O2

reproducer="${output}/failure-reproducer"
rg -q 'struct gen_shape_27' "${reproducer}/reproducer.c"
rg -q 'gen_consume_27' "${reproducer}/reproducer.c"
jq -e '.shapes | length == 1 and .[0].id == 27' \
  "${reproducer}/shape.json" >/dev/null
jq -e '.case_id == 54 and .shape_id == 27 and .route == "llvm" and
       .optimization == "O2" and .seed == 23130 and
       .expected == 13656 and .actual == 31106' \
  "${reproducer}/failure.json" >/dev/null
rg -q 'route: `llvm`' "${reproducer}/README.md"
rg -q -- '-O2' "${reproducer}/README.md"

echo "aggregate failure reducer self-test passed: ${reproducer}"
