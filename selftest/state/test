#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${project_root}/harness/common.sh"
source "${project_root}/harness/state.sh"

run_dir="${C166_TEST_ARTIFACT_ROOT:-${project_root}/build}/selftest-state"
mkdir -p "$run_dir"
c166_state_initialize "$run_dir" /source/case example abi large O2 "" system ext2
c166_state_complete_stage "$run_dir" inputs-prepared
c166_state_complete_stage "$run_dir" llvm-linked

jq -e '
  .schema_version == 1 and .case == "example" and .category == "abi" and
  .model == "large" and .optimization == "O2" and
  .tasking_variant == "ext2" and
  .source_case == "example" and
  .stages == ["initialized", "inputs-prepared", "llvm-linked"]
' "${run_dir}/run-state.json" >/dev/null

if (c166_state_complete_stage "$run_dir" llvm-linked) >/dev/null 2>&1; then
  echo "run state accepted a duplicate stage" >&2
  exit 1
fi

echo "C166 run-state self-test passed"
