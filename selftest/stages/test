#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${project_root}/harness/common.sh"
source "${project_root}/harness/imports.sh"
source "${project_root}/harness/manifest.sh"
source "${project_root}/harness/overlay.sh"
source "${project_root}/harness/result.sh"

run_dir="$(c166_new_run_dir selftest-stages)"
manifest="${project_root}/tests/abi/regargs/case.json"
c166_manifest_validate_configuration "$manifest" O2 large
declare -A manifest_config=()
llvm_sources=()
llvm_mir_sources=()
tasking_sources=()
tasking_nodebug_sources=()
tasking_import_symbols=()
tasking_asm_sources=()
case_inputs=()
required_symbols=()
extra_clang_flags=()
defines=()
extra_ldflags=()
tasking_required_symbols=()
c166_manifest_load "$manifest" large ext manifest_config llvm_sources \
  llvm_mir_sources tasking_sources tasking_nodebug_sources \
  tasking_import_symbols tasking_asm_sources case_inputs required_symbols \
  extra_clang_flags defines extra_ldflags tasking_required_symbols
[[ "${manifest_config[category]}" == abi ]]
[[ "${manifest_config[result_protocol]}" == scalar ]]
[[ "${manifest_config[runtime_variant]}" == ext ]]
[[ "${llvm_sources[*]}" == llvm.c ]]
if (c166_manifest_validate_configuration "$manifest" O2 medium) \
    >/dev/null 2>&1; then
  c166_die "manifest stage accepted a disabled memory model"
fi

mapper="${run_dir}/mapper"
cat >"$mapper" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
shift
for symbol in "$@"; do printf '%s\n' "--defsym=${symbol}=0x1234"; done
EOF
chmod +x "$mapper"
: >"${run_dir}/host.map"
symbols=(_one _two)
flags=(--gc-sections)
c166_add_import_placeholders symbols flags
[[ " ${flags[*]} " == *' --defsym=_one=0 '* ]]
c166_resolve_tasking_imports "$mapper" "${run_dir}/host.map" \
  "${run_dir}/imports.ldflags" symbols flags
[[ " ${flags[*]} " == *' --gc-sections '* ]]
[[ " ${flags[*]} " == *' --defsym=_one=0x1234 '* ]]
[[ " ${flags[*]} " != *' --defsym=_one=0 '* ]]

fake_objdump="${run_dir}/objdump"
cat >"$fake_objdump" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' '.c166.near.text' '.c166.near.data' '.c166.xnear.bss'
EOF
chmod +x "$fake_objdump"
overlay_args=(--replace 0x100000:0x2fffff)
use_dpp=false
c166_configure_overlay_from_elf "$fake_objdump" elf large \
  overlay_args use_dpp
[[ "$use_dpp" == true ]]
[[ " ${overlay_args[*]} " == *' --fill 0xb8000:0xbffff '* ]]
[[ " ${overlay_args[*]} " == *' --fill 0x6000:0x6fff '* ]]

fake_readobj="${run_dir}/readobj"
cat >"$fake_readobj" <<'EOF'
#!/usr/bin/env bash
cat <<'JSON'
[{"Sections":[{"Section":{"Type":{"Name":"SHT_NOBITS"},"Size":16,"Address":4194304,"Flags":{"Flags":[{"Name":"SHF_ALLOC"}]}}}]}]
JSON
EOF
chmod +x "$fake_readobj"
c166_add_nobits_overlay_ranges "$fake_readobj" elf overlay_args
[[ " ${overlay_args[*]} " == *' --fill 4194304:4194319 '* ]]

c166_validate_simulator_result "${project_root}/tools/check-result-log" \
  "${project_root}/selftest/result/good.log" block '' 1 2459629185 \
  "$run_dir" O2 ''

echo "C166 manifest/import/overlay/result stage self-test passed"
