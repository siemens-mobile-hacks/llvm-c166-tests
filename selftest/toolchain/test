#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${project_root}/harness/common.sh"
source "${project_root}/harness/toolchain.sh"

fixture="${C166_TEST_ARTIFACT_ROOT:-${project_root}/build}/selftest-toolchain"
llvm_build="${fixture}/llvm"
tasking_root="${fixture}/tasking"
mkdir -p "${llvm_build}/bin" "${tasking_root}/bin"

for tool in clang ld.lld llc llvm-objcopy llvm-objdump llvm-nm llvm-readobj; do
  printf '#!/usr/bin/env bash\nexit 0\n' >"${llvm_build}/bin/${tool}"
  chmod +x "${llvm_build}/bin/${tool}"
done
for tool in a166.exe m166.exe cc166.exe ihex166.exe xfw166.exe; do
  : >"${tasking_root}/bin/${tool}"
done

declare -A tools=()
c166_toolchain_configure "$llvm_build" "$tasking_root" tools
c166_toolchain_verify tools true
[[ "${tools[clang]}" == "${llvm_build}/bin/clang" ]]
[[ "${tools[cc166]}" == "${tasking_root}/bin/cc166.exe" ]]

chmod -x "${llvm_build}/bin/llc"
if (c166_toolchain_verify tools false) >/dev/null 2>&1; then
  echo "toolchain verification accepted a non-executable llc" >&2
  exit 1
fi

echo "C166 toolchain discovery self-test passed"
