GENERAL
NOPAGING
LISTSYMBOLS
SYMBOLCOLUMNS(1)
; The shared layout names optional sections and overlapping fixture classes.
; Their absence or overlap is expected when another case is being linked.
NOWARNING(145,152,154)
@IF( @TASKING_MODEL_IS_SMALL )
  ; Keep Small's 16-bit direct-address encoding equal to the physical address
  ; in the ELF overlay window.  The C initializer consumes the corresponding
  ; ?BASE_DPPn symbols, so both toolchains execute with the same mapping.
  SETNOSGDPP(DPP0(0), DPP1(1), DPP2(4), DPP3(3))
@ENDI

RESERVE
(
  SYSSTACK(1)
)

ADDRESSES SECTIONS
(
  ; Reserved software-trap vector used by the interrupt ABI fixtures.  TRAP
  ; 7Ch enters 0:01F0h and creates the real architectural IP/CSP/PSW frame;
  ; fixtures provide the four-byte vector body, while all other images leave
  ; this fixed slot empty.

  ; Keep model-independent floating constants and the result block out of the
  ; complete 0x4000--0x7fff user-stack page.  The current TASKING compiler
  ; correctly materializes the stack-page-limit volatile local at 0x7ffe;
  ; deterministic placement keeps C166_XGROUP on page 1 for that real access.
  FLOAT_WIDTH_VALUES(0F240h)
  C166_TEST_HARNESS_2_FB(0F200h)

  ; Medium ordinary code must remain in the first 64 KiB code segment.  The
  ; TASKING host occupies the normal low CPROGRAM area; this single fixed
  ; reservation is overlaid by the LLVM near entry and near text.
  LLVM_MEDIUM_TEXT_RESERVATION(0C000h)

  ; Fixed TASKING-generated Medium callees used by bidirectional ABI tests.
  ; The ordinary target remains in the first segment; the explicit-huge
  ; target deliberately lives outside it.
  MEDIUM_NEAR_TARGET_2_PR(08000h)
  MEDIUM_HUGE_TARGET_2_PR(0F0000h)

  ; TASKING-compiled functions used by bidirectional ABI tests.  Medium calls
  ; remain in the first code segment; Large and Small use fixed far slots.
@IF( @TASKING_MODEL_IS_MEDIUM )
  TASKING_2_PR(08100h)
  TASKING_3_PR(08300h)
  TASKING_4_PR(08500h)
  TASKING_5_PR(08700h)
  TASKING_6_PR(08900h)
  TASKING_7_PR(08B00h)
  TASKING_8_PR(08D00h)
  TASKING_9_PR(08F00h)
  TASKING_10_PR(09100h)
  TASKING_11_PR(09300h)
  TASKING_12_PR(09500h)
  TASKING_13_PR(09700h)
  TASKING_14_PR(09900h)
  TASKING_15_PR(09B00h)
  TASKING_16_PR(09D00h)
  TASKING_17_PR(09F00h)
  TASKING_18_PR(0A100h)
  TASKING_19_PR(0A300h)
  TASKING_20_PR(0A500h)
  TASKING_21_PR(0A700h)
  TASKING_22_PR(0A900h)
  TASKING_23_PR(0AB00h)
  TASKING_24_PR(0AD00h)
@ELSE
